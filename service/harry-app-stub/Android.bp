rust_binary {
    name: "harry_app_stub",
    crate_name: "harry_app_stub",
    srcs: [
        "src/main.rs",
    ],
    stem: "harry",
    installable: false,
    prefer_rlib: true,
    rustlibs: [
        "libsdv_log_rust",
        "liblog_rust",
        "libhar_grpc_services",
        "libhar_tracing_common",
        "libprotobuf",
        "libgrpcio",
        "librand",
        "libtokio",
        "libfutures",
        "librustutils",
    ],
    vendor: true,
    defaults: [
        "sdv_tracing@rust_defaults",
    ],
}
