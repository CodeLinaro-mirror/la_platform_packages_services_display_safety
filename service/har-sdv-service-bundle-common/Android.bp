// Copyright 2024 Google LLC

rust_library {
    name: "libhar_sdv_service_bundle_common",
    crate_name: "har_sdv_service_bundle_common",
    srcs: [
        "src/lib.rs",
    ],

    prefer_rlib: true,
    rustlibs: [
        "liblog_rust",
        // Contains all SDV libraries accessed from user code
        "libsdv_rs",
        // Tokio libs.
        "libtokio",
        "libtokio_util",
        // Rust foundations for asynchronous programming.
        "libfutures",
    ],
    apex_available: [
        "//apex_available:platform",
        "//apex_available:anyapex",
    ],
    proc_macros: [
        "libasync_trait",
    ],
    product_specific: true,
}
