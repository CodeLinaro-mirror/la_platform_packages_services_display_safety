// Copyright 2024 Google LLC

// Deprecated: This package is no longer in-use on
// APEX-based configurations.
rust_binary {
    name: "har_user_preferences_service",
    crate_name: "har_user_preferences_service",
    srcs: [
        "src/main.rs",
    ],
    defaults: ["har_user_preferences@rust_defaults"],
    vendor_available: true,
    product_available: true,
}

rust_defaults {
    name: "har_user_preferences@rust_defaults",
    defaults: [
        "sdv@rust_defaults",
    ],
    rustlibs: [
        "libprotobuf",
        "libsdvgenerated_har_user_preferences_server",
        "libuser_preferences_api",
        "libbinder_rs",
        "libsdvmiddleware_rpc",
        "libitertools",
        "librand",
        "libsdv_log_rust",
        "liblog_rust",
        "libuser_preferences_utils",
        "libprotobuf_parse",
        "librustutils",
        "libsdvmiddleware_rpc_grpc_transport",
        "libsdvgenerated_rpc_sdv_user_preferences_user_controllable_user_controllable_service",
        "libsdvgenerated_rpc_sdv_user_preferences_view_change_notifier",
    ],
}

// Service bundle library for Vehicle Data Publisher.
rust_ffi_shared {
    name: "libhar_sdv_user_preferences_service_bundle",
    srcs: ["src/lib.rs"],
    crate_name: "har_sdv_user_preferences_service_bundle",
    rustlibs: [
        // Contains service bundle interface definitions and helper macros.
        "libsdv_lifecycle_client_rust",
        // commstack library that provides context object reference.
        "libsdv_comms_rs",
        "libsdv_log_rust",
        "liblog_rust",
        "libprotobuf",
        "librand",
        "libfutures",
        "libbinder_rs",
        "libitertools",
        "librustutils",
        "libuser_preferences_api",
        "libsdvmiddleware_rpc",
        "libsdvmiddleware_rpc_grpc_transport",
        "libsdvgenerated_har_user_preferences_server",
        "libsdvgenerated_rpc_sdv_user_preferences_user_controllable_user_controllable_service",
        "libsdvgenerated_rpc_sdv_user_preferences_view_change_notifier",
        "libuser_preferences_utils",
    ],
    // Allows the library to be available inside APEX.
    apex_available: [
        "//apex_available:platform",
        "//apex_available:anyapex",
    ],
    // Service bundle package is packed into /product apexes.
    product_specific: true,
}
