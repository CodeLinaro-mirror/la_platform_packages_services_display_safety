rust_binary {
    name: "har_preferences_service",
    crate_name: "har_preferences_service",
    srcs: [
        "src/main.rs",
    ],
    prefer_rlib: true,
    rustlibs: [
        "libtokio",
        "libprotobuf",
        "libsdv_log_rust",
        "liblog_rust",
        "libsdvgenerated_har_preferences_service",
        "libsdvgenerated_rpc_sdv_user_preferences_user_preferences_registry_service",
        "libuser_preferences_api",
        "libsdvmiddleware_rpc",
        "libhar_grpc_services",
        "libitertools",
        "libuser_preferences_utils",
        "libsdvmiddleware_rpc_grpc_transport",
        "libgrpcio",
        "libfutures_util",
        "libfutures",
        "libhar_sdv_rpc",
        "google.sdv.sd_common-aidl-V1-rust",
    ],
    vendor: true,
}
