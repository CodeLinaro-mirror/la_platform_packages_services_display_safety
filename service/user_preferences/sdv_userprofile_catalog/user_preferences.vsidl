# proto-file: //system/software_defined_vehicle/core_services/vsidl/syntax/vsidl.proto
# proto-message: VsidlEntry

package: "har.user_preferences"

# Service bundle for the generic SDV User preferences server
sdv_service_bundle {
    name: "UserPreferencesServer"
    client: "sdv.user_preferences.user_controllable.UserControllableService"
    client: "sdv.user_preferences.view.ChangeNotifier"
    server: "sdv.user_preferences.UserPreferencesAdminService"
    server: "sdv.user_preferences.UserPreferencesManagementService"
    server: "sdv.user_preferences.UserPreferencesRegistryService"
}

# Service bundle for HAR to control user preferences
sdv_service_bundle {
    name: "HarPreferencesService"
    server: "sdv.user_preferences.user_controllable.UserControllableService"
    client: "sdv.user_preferences.UserPreferencesRegistryService"
}

sdv_service_bundle {
    name: "HarPreferencesClient"
    # Server to receive changes on subscribed preferences
    server: "sdv.user_preferences.view.ChangeNotifier"
    # Client to manage preferences
    client: "sdv.user_preferences.UserPreferencesManagementService"
    # Client to manage users
    client: "sdv.user_preferences.UserPreferencesAdminService"
}

# Service bundle dedicated to test utils to simulate an IVI instance and change prefs.
# Trying to reuse HarPreferencesClient in another binary would cause name conflicts.
sdv_service_bundle {
    name: "HarPreferencesAdmin"
    # Client to manage preferences
    client: "sdv.user_preferences.UserPreferencesManagementService"
    # Client to manage users
    client: "sdv.user_preferences.UserPreferencesAdminService"
}