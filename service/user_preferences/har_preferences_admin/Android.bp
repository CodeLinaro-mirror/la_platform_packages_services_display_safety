rust_binary {
    name: "har_preferences_admin",
    crate_name: "har_preferences_admin",
    srcs: [
        "src/main.rs",
    ],
    prefer_rlib: true,
    rustlibs: [
        "libtokio",
        "libsdvgenerated_har_preferences_admin",
        "liboem_harry_vehicle_messages_catalog",
        "libprotobuf",
        "libsdv_log_rust",
        "liblog_rust",
        "libsdvgenerated_harry_vehicle_data_subscriber",
        "libsdv_middleware_pubsub",
        "libhar_grpc_services",
        "libuser_preferences_api",
        "libsdvmiddleware_rpc",
        "libitertools",
        "libhar_grpc_services",
        "libuser_preferences_utils",
        "libsdvmiddleware_rpc_grpc_transport",
        "libgrpcio",
        "libfutures_util",
        "libfutures",
        "libhar_sdv_rpc",
        "google.sdv.sd_common-aidl-V1-rust",
    ],
    vendor_available: true,
    product_available: true,
}
