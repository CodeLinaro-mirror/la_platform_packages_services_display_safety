// The prebuilt binary package using DRM for rendering.
cc_prebuilt_binary {
    // TODO: Rename this to harry-sdv or similar to allow a different
    // variant with different dependencies for non-SDV systems.
    name: "harry",
    owner: "google",

    arch: {
        arm: {
            enabled: false,
        },
        arm64: {
            srcs: ["arm64/harry"],
        },
        x86: {
            enabled: false,
        },
        x86_64: {
            srcs: ["x86_64/harry"],
        },
    },
    shared_libs: [
        "libGLESv2", "libgbm", "liblog"
    ],
    // Copied by the mk file.
    init_rc: ["harry_init.rc"],
    vendor: true,
}

// The prebuilt binary package using libhar_graphics for rendering.
cc_prebuilt_binary {
    // TODO: Rename this to harry-sdv or similar to allow a different
    // variant with different dependencies for non-SDV systems.
    name: "harry_har_graphics",
    owner: "google",

    arch: {
        arm: {
            enabled: false,
        },
        arm64: {
            srcs: ["arm64/harry_har_graphics"],
        },
        x86: {
            enabled: false,
        },
        x86_64: {
            srcs: ["x86_64/harry_har_graphics"],
        },
    },
    shared_libs: [
        "libhar_graphics"
    ],
    // Copied by the mk file.
    init_rc: ["harry_init.rc"],
}

// Defaults for resource file modules
prebuilt_defaults {
    name: "harry_res_defaults",
    filename_from_src: true,
    sub_dir: "harry",
    vendor: true,
}

// All resource file has to declare its own module.
prebuilt_etc {
    name: "harry_res_config",
    src: "data/harry-config.json",
    defaults: ["harry_res_defaults"],
}

prebuilt_etc {
    name: "harry_res_audio_config",
    src: "data/harry-audio-device-config.json",
    defaults: ["harry_res_defaults"],
}

prebuilt_etc {
