// The prebuilt binary package using DRM for rendering.
cc_prebuilt_binary {
    // TODO: Rename this to harry-sdv or similar to allow a different
    // variant with different dependencies for non-SDV systems.
    name: "harry",
    owner: "google",

    arch: {
        arm: {
            enabled: false,
        },
        arm64: {
            srcs: ["arm64/harry"],
        },
        x86: {
            enabled: false,
        },
        x86_64: {
            srcs: ["x86_64/harry"],
        },
    },
    shared_libs: [
        "libGLESv2", "libgbm", "liblog", "libEGL"
    ],
    vendor: true,
}

// The prebuilt binary package using libhar_graphics for rendering.
cc_prebuilt_binary {
    // TODO: Rename this to harry-sdv or similar to allow a different
    // variant with different dependencies for non-SDV systems.
    name: "harry_har_graphics",
    owner: "google",

    arch: {
        arm: {
            enabled: false,
        },
        arm64: {
            srcs: ["arm64/harry_har_graphics"],
        },
        x86: {
            enabled: false,
        },
        x86_64: {
            srcs: ["x86_64/harry_har_graphics"],
        },
    },
    shared_libs: [
        "libhar_graphics"
    ],
}

// Defaults for resource file modules
prebuilt_defaults {
    name: "harry_res_defaults",
    relative_install_path: "harry",
    vendor: true,
}

// All resource file has to declare its own module.
prebuilt_etc {
    name: "harry_res_config",
    src: "data/harry-config.json",
    defaults: ["harry_res_defaults"],
    filename_from_src: true,
}

prebuilt_etc {
    name: "harry_res_audio_config",
    src: "data/harry-audio-device-config.json",
    defaults: ["harry_res_defaults"],
    filename_from_src: true,
}

prebuilt_etc {
    name: "harry_res_chimes_config",
    src: "data/harry-chimes-config.json",
    defaults: ["harry_res_defaults"],
    filename_from_src: true,
}

prebuilt_etc {
    name: "harry_res_audio_chimes",
    srcs: [
        "data/chimes/tick.48000.wav",
        "data/chimes/tock.48000.wav",
        "data/chimes/welcome_to_harry.48000.wav",
        "data/chimes/wilhelm_scream.48000.wav",
        "data/chimes/welcome_to_harry.mono.48000.wav",
        "data/chimes/wilhelm_scream.mono.48000.wav",
    ],
    defaults: ["harry_res_defaults"],
    relative_install_path: "harry/chimes",
}

prebuilt_etc {
    name: "harry_res_camera_config",
    src: "data/harry-camera-config-android.json",
    defaults: ["harry_res_defaults"],
    filename_from_src: true,
}

prebuilt_etc {
    name: "harry_res_camera_emulation_source",
    src: "data/camera/camera_emulation.mp4",
    defaults: ["harry_res_defaults"],
    relative_install_path: "harry/camera",
    filename_from_src: true,
}

prebuilt_etc {
    name: "harry_res_documents",
    srcs: [
        "data/SB6ME0eT2ku8rFT7Y3eBX8",
        "data/GLJJrR1JI4HVEjL1qB40zq",
        "data/SqyhHN0IUVYPP4qB3NyWW9",
        "data/MdvJSKWuTjjLIXlNHZB2Au",
    ],
    defaults: ["harry_res_defaults"],
}

// Fonts
prebuilt_etc {
    name: "harry_res_fonts",
    srcs: [
        "data/inter_black.otf",
        "data/inter_bold.otf",
        "data/inter_regular.otf",
        "data/NotoSans-Black.ttf",
        "data/NotoSans-Bold.ttf",
        "data/NotoSans-ExtraBold.ttf",
        "data/NotoSans-ExtraLight.ttf",
        "data/NotoSans-Light.ttf",
        "data/NotoSans-Medium.ttf",
        "data/NotoSans-Regular.ttf",
        "data/NotoSans-SemiBold.ttf",
        "data/NotoSans-Thin.ttf",
        "data/PTSansNarrow-Bold.ttf",
        "data/PTSansNarrow-Regular.ttf",
    ],
    defaults: ["harry_res_defaults"],
}
