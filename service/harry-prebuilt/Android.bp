// Copyright 2024 Google LLC

// Generates a non-functional placeholder prebuilt to not break builds for unsupported targets.
genrule {
    name: "harry_binary_placeholder",
    cmd: "touch $(out) && chmod a+x $(out)",
    out: ["harry_binary_placeholder.unused"],
}

// The prebuilt binary package using DRM for rendering.
cc_prebuilt_binary {
    // TODO: Rename this to harry-sdv or similar to allow a different
    // variant with different dependencies for non-SDV systems.
    name: "harry_app_prebuilt",
    overrides: ["harry_app_stub"],
    installable: false,
    prefer: true,
    owner: "google",
    stem: "harry",
    arch: {
        arm: {
            srcs: [":harry_binary_placeholder"],
        },
        arm64: {
            srcs: ["arm64/harry"],
        },
        x86: {
            srcs: [":harry_binary_placeholder"],
        },
        x86_64: {
            srcs: ["x86_64/harry"],
        },
        riscv64: {
            srcs: [":harry_binary_placeholder"],
        },
    },
    shared_libs: [
        "libGLESv2",
        "libgbm",
        "liblog",
        "libEGL",
        "libimpeller",
        "libandroid",
    ],
    vendor: true,
}

// The prebuilt binary package using libhar_graphics for rendering.
cc_prebuilt_binary {
    // TODO: Rename this to harry-sdv or similar to allow a different
    // variant with different dependencies for non-SDV systems.
    name: "harry_har_graphics",
    owner: "google",

    arch: {
        arm: {
            enabled: false,
        },
        arm64: {
            srcs: ["arm64/harry_har_graphics"],
        },
        x86: {
            enabled: false,
        },
        x86_64: {
            srcs: ["x86_64/harry_har_graphics"],
        },
    },
    shared_libs: [
        "libhar_graphics",
    ],
}

// The Impeller library is built by the Flutter team and fetched from
// https://storage.googleapis.com/flutter_infra_release/flutter
// See go/flutter-slsa-bcid-status for SLSA/BCID information.
cc_prebuilt_library_shared {
    name: "libimpeller",
    vendor: true,

    target: {
        android_arm: {
            srcs: ["arm/libimpeller.so"],
        },
        android_arm64: {
            srcs: ["arm64/libimpeller.so"],
        },
        android_x86: {
            srcs: ["x86/libimpeller.so"],
        },
        android_x86_64: {
            srcs: ["x86_64/libimpeller.so"],
        },
        android_riscv64: {
            srcs: [":harry_binary_placeholder"],
        },
    },
    shared_libs: [
        "liblog",
    ],
}

// Defaults for resource file modules
prebuilt_defaults {
    name: "harry_asset_defaults",
    relative_install_path: "harry/assets",
    vendor: true,
}

// TODO this needs to be turned into a genrule
prebuilt_etc {
    name: "harry_resource_archive",
    srcs: [
        "data/assets/resources.tar",
    ],
    defaults: ["harry_asset_defaults"],
    relative_install_path: "harry/assets",
}

prebuilt_etc {
    name: "harry_asset_audio",
    srcs: [
        "data/assets/common/chimes/welcome_to_harry.mono.48000.wav",
        "data/assets/common/chimes/alert.mono.48000.wav",
    ],
    defaults: ["harry_asset_defaults"],
    relative_install_path: "harry/assets/common/chimes",
}

prebuilt_etc {
    name: "harry_asset_camera",
    srcs: [
        "data/assets/common/camera/camera_emulation.mp4",
    ],
    defaults: ["harry_asset_defaults"],
    relative_install_path: "harry/assets/common/camera",
}

prebuilt_etc {
    name: "harry_asset_common_configs",
    srcs: [
        "data/assets/common/config/harry-camera-config-emulated.json",
        "data/assets/common/config/harry-config.json",
    ],
    defaults: ["harry_asset_defaults"],
    relative_install_path: "harry/assets/common/config",
}

prebuilt_etc {
    name: "harry_asset_sdv_configs",
    srcs: [
        "data/assets/sdv/config/harry-camera-config-android.json",
        "data/assets/sdv/config/harry-audio-device-config.json",
        "data/assets/sdv/config/harry-chimes-config.json",
    ],
    defaults: ["harry_asset_defaults"],
    relative_install_path: "harry/assets/sdv/config",
}

prebuilt_etc {
    name: "harry_asset_documents",
    srcs: [
        "data/assets/common/figma/SB6ME0eT2ku8rFT7Y3eBX8",
    ],
    defaults: ["harry_asset_defaults"],
    relative_install_path: "harry/assets/common/figma",
}

// Fonts
prebuilt_etc {
    name: "harry_asset_fonts",
    srcs: [
        "data/assets/common/localization/fonts/inter_black.otf",
        "data/assets/common/localization/fonts/inter_bold.otf",
        "data/assets/common/localization/fonts/inter_regular.otf",
        "data/assets/common/localization/fonts/NotoSans-Black.ttf",
        "data/assets/common/localization/fonts/NotoSans-Bold.ttf",
        "data/assets/common/localization/fonts/NotoSans-ExtraBold.ttf",
        "data/assets/common/localization/fonts/NotoSans-ExtraLight.ttf",
        "data/assets/common/localization/fonts/NotoSans-Light.ttf",
        "data/assets/common/localization/fonts/NotoSans-Medium.ttf",
        "data/assets/common/localization/fonts/NotoSans-Regular.ttf",
        "data/assets/common/localization/fonts/NotoSans-SemiBold.ttf",
        "data/assets/common/localization/fonts/NotoSans-Thin.ttf",
        "data/assets/common/localization/fonts/PTSansNarrow-Bold.ttf",
        "data/assets/common/localization/fonts/PTSansNarrow-Regular.ttf",
        "data/assets/common/localization/fonts/Roboto-Black.ttf",
        "data/assets/common/localization/fonts/Roboto-Bold.ttf",
        "data/assets/common/localization/fonts/Roboto-Light.ttf",
        "data/assets/common/localization/fonts/Roboto-Medium.ttf",
        "data/assets/common/localization/fonts/Roboto-Regular.ttf",
        "data/assets/common/localization/fonts/Roboto-Thin.ttf",
    ],
    defaults: ["harry_asset_defaults"],
    relative_install_path: "harry/assets/common/localization/fonts/",
}

prebuilt_etc {
    name: "harry_asset_locales",
    srcs: [
        "data/assets/common/localization/locales/default.protobuf",
        "data/assets/common/localization/locales/fr.protobuf",
        "data/assets/common/localization/locales/fr-CA.protobuf",
    ],
    defaults: ["harry_asset_defaults"],
    relative_install_path: "harry/assets/common/localization/locales/",
}
