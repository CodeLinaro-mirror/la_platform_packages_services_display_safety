// Copyright 2024 Google LLC

// WARNING: The usage of this implementation is unsafe
// and only meant for internal testing.

cc_defaults {
    name: "libhar_graphics_defaults",

    cflags: [
        "-DGL_GLEXT_PROTOTYPES",
        "-DEGL_EGLEXT_PROTOTYPES",

        "-Wall",
        "-Werror",
        "-Wunused",
        "-Wunreachable-code",
    ],

    shared_libs: [
        "libandroidfw",
        "libbase",
        "libbinder",
        "libcutils",
        "liblog",
        "libutils",
    ],
}

// libhar_graphics
// ===========================================================
// static or shared
cc_library_shared {
    name: "libhar_graphics",
    defaults: ["libhar_graphics_defaults"],

    srcs: [
        "GLDriver.cpp",
        "HarGraphics.cpp",
    ],

    shared_libs: [
        "libui",
        "libjnigraphics",
        "libEGL",
        "libGLESv2",
        "libgui",
    ],
}
