// Copyright 2024 Google LLC

rust_binary {
    name: "har_sdv_service",
    crate_name: "har_sdv_service",
    srcs: [
        "src/main.rs",
    ],
    lints: "none",
    prefer_rlib: true,
    rustlibs: [
        "libtokio",
        "liboem_harry_vehicle_messages_catalog",
        "libprotobuf",
        "libsdv_log_rust",
        "liblog_rust",
        "libsdvgenerated_harry_vehicle_data_subscriber",
        "libsdv_middleware_pubsub",
        "libhar_grpc_services",
        "libuser_preferences_api",
        "libsdvgenerated_har_preferences_client",
        "libsdvmiddleware_rpc",
        "libitertools",
        "libuser_preferences_utils",
        "libsdvmiddleware_rpc_grpc_transport",
        "libsdvgenerated_rpc_sdv_user_preferences_view_change_notifier",
        "libgrpcio",
        "libfutures_util",
        "libfutures",
        "libhar_sdv_rpc",
        "librustutils",
        "google.sdv.sd_common-aidl-V1-rust",
    ],
    vendor_available: true,
    product_available: true,
}

// Service bundle library for Vehicle Data Publisher.
rust_ffi_shared {
    name: "libhar_sdv_service_bundle",
    enabled: select(soong_config_variable("SDV", "SDV_PREBUILT"), {
        "true": false,
        default: true,
    }),
    srcs: ["src/lib.rs"],
    lints: "none",
    crate_name: "har_sdv_service_bundle",
    prefer_rlib: true,
    rustlibs: [
        "libtokio",
        "liboem_harry_vehicle_messages_catalog",
        "libprotobuf",
        "libsdv_log_rust",
        "liblog_rust",
        "libhar_sdv_rpc",
        "libsdvgenerated_harry_vehicle_data_subscriber",
        "libsdv_middleware_pubsub",
        "libhar_grpc_services",
        "libuser_preferences_api",
        "libsdvgenerated_har_preferences_client",
        "libsdvmiddleware_rpc",
        "libitertools",
        "libuser_preferences_utils",
        "libsdvmiddleware_rpc_grpc_transport",
        "libsdvgenerated_rpc_sdv_user_preferences_view_change_notifier",
        "libgrpcio",
        "libfutures_util",
        "libfutures",
        "google.sdv.lifecycle-V1-rust",
        "google.sdv.identity-aidl-V1-rust",
        "librustutils",
        "google.sdv.sd_common-aidl-V1-rust",
        // Contains service bundle interface definitions and helper macros.
        "libsdv_lifecycle_client_rust",
        // commstack library that provides context object reference.
        "libsdv_comms_rs",
        "libharry_vehicle_data_grpc",
        "librand",
        "libtokio_util",
        "libhar_sdv_service_bundle_common",
    ],
    // Allows the library to be available inside APEX.
    apex_available: [
        "//apex_available:platform",
        "//apex_available:anyapex",
    ],
    // Service bundle package is packed into /product apexes.
    product_specific: true,
}
