// Copyright 2024 Google LLC

// Service bundle library for Vehicle Data Publisher.
rust_ffi_shared {
    name: "libhar_sdv_service_bundle",
    enabled: select(soong_config_variable("SDV", "SDV_PREBUILT"), {
        "true": false,
        default: true,
    }),
    srcs: ["src/lib.rs"],
    crate_name: "har_sdv_service_bundle",
    prefer_rlib: true,
    rustlibs: [
        "liblog_rust",
        "libprotobuf",
        "libitertools",
        "libgrpcio",
        "librustutils",
        "librand",
        "libfutures",
        "libfutures_util",
        "libtokio",
        "libtokio_util",
        // HAR libraries
        "libhar_sdv_service_bundle_common",
        "libhar_grpc_services",
        "libharry_vehicle_data_grpc",
        // catalog
        "liboem_harry_vehicle_messages_catalog_v1",
        // v1 comms based on SDV generated code
        "libsdv_mw_rs_com_sdv_google_display_safety_har_sdv_service_bundle",
        "libcom_sdv_google_display_safety_driver_ui_service_rpc_rs",
        // HAR Service discovery implementation
        "libhar_sdv_rpc",
        // SDV libraries
        "libsdv_log_rust",
        "libsdv_rs",
    ],
    // Allows the library to be available inside APEX.
    apex_available: [
        "//apex_available:platform",
        "//apex_available:anyapex",
    ],
    proc_macros: [
        "libasync_trait",
    ],
    // Helps with `ApexSupport: Could not load ...so: dlopen failed: cannot locate symbol "ASDV_..." referenced by ...`
    ld_flags: ["-Wl,--no-as-needed"],
    // Service bundle package is packed into /product apexes.
    product_specific: true,
}
