package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// TODO(b/334163598): Remove dependency on Data Tunnel libraries in the JNI lib.
cc_defaults {
    name: "libharsdvgateway_jni@cc_defaults",
    cflags: [
        "-Werror",
    ],
    header_libs: [
        "jni_headers",
    ],
    srcs: [
        "JniLoader.cpp",
    ],
    shared_libs: [
        "google.sdv.dt-aidl-V1-ndk",
        "google.sdv.rpc-aidl-V1-ndk",
        "libbase",
        "liblog",
        "libprotobuf-cpp-full",
        "libsdv_dt",
        "libsdv_dt_core",
        "libsdvgateway",
    ],
    static_libs: [
        "libsdvgateway_proto_cpp",
    ],
    stl: "c++_static",
}

cc_library_shared {
    name: "libharsdvgateway_jni",
    defaults: ["libharsdvgateway_jni@cc_defaults"],
    cflags: [
        "-DLOG_TAG=\"CarEvsSdvConnectionManager\"",
    ],
}
