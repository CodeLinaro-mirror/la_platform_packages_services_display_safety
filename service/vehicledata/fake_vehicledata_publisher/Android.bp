rust_binary {
    name: "fake_vehicledata_publisher_service",
    crate_name: "fake_vehicledata_publisher_service",
    srcs: [
        "src/main.rs",
    ],
    prefer_rlib: true,
    rustlibs: [
        "libsdv_log_rust",
        "liblog_rust",
        "liboem_harry_vehicle_messages_catalog",
        "libprotobuf",
        "librand",
        "libsdvgenerated_harry_vehicle_data_publisher",
        "libsdv_middleware_pubsub",
        "libtokio",
        "libfutures",
    ],
    vendor: true,
}
