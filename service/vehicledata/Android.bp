// These two Soong module definitions provide the basis to enable or disable certain
// dependencies whether we are compiling with the binary PDK or not.
// In the case we compile with the binary PDK, we set the environment variable SDV_PREBUILT to true
// (export SDV_PREBUILT=true), which is picked up by the build system in
// device/google/sdv/sdv_base/soong_config.mk and then put into the variable with the same name
// in the SDV namespace.
//
// The Soong variable SDV_PREBUILT is true, when we built with the binary PDK, else it is false.

soong_config_module_type {
    name: "sdv_sdv_prebuilt_rust_defaults",
    module_type: "rust_defaults",
    config_namespace: "SDV",
    bool_variables: ["SDV_PREBUILT"],
    properties: [
        "rustlibs",
    ],
}

sdv_sdv_prebuilt_rust_defaults {
    name: "libhar_sdv_vehicle_data_publisher_service_bundle_non_binary_pdk_dependencies",
    soong_config_variables: {
        SDV_PREBUILT: {
            rustlibs: [
                // Contains service bundle interface definitions and helper macros.
                "libsdv_lifecycle_client_rust",
            ],
        },
    },
}
