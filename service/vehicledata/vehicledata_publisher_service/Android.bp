// Copyright 2024 Google LLC

filegroup {
    name: "harry_vehicle_data_grpc_protos",
    srcs: [
        "proto/vehicledata_grpc_service.proto",
    ],
}

rust_protobuf {
    name: "libharry_vehicle_data_grpc",
    crate_name: "harry_vehicle_data_grpc",
    grpc_protos: [
        ":harry_vehicle_data_grpc_protos",
    ],
    // TODO(335314414): Use the proto files from the sdv_vehicledata_catalog
    protos: [
        "proto/vehicle_tire.proto",
        "proto/vehicledata.proto",
    ],
    proto_flags: [
        "-I vendor/google/display_safety/service/vehicledata/vehicledata_publisher_service/proto",
    ],
    source_stem: "harry_vehicle_data_grpc_source",
    vendor_available: true,
    product_available: true,
}

// Service bundle library for Vehicle Data Publisher.
rust_ffi_shared {
    name: "libhar_sdv_vehicle_data_publisher_service_bundle",
    defaults: ["libhar_sdv_vehicle_data_publisher_service_bundle_non_binary_pdk_dependencies"],
    srcs: ["src/lib.rs"],
    crate_name: "har_sdv_vehicle_data_publisher_service_bundle",
    prefer_rlib: true,
    // Helps with `ApexSupport: Could not load ...so: dlopen failed: cannot locate symbol "ASDV_..." referenced by ...`
    ld_flags: ["-Wl,--no-as-needed"],
    rustlibs: [
        "libsdv_log_rust",
        "liblog_rust",
        "libprotobuf",
        "librand",
        "libfutures",
        "libharry_vehicle_data_grpc",
        "libgrpcio",
        "libthiserror",
        // Contains all SDV libraries accessed from user code
        "libsdv_rs",
        // Tokio coroutines.
        "libtokio",
        "libtokio_util",
        // common utils
        "libhar_sdv_service_bundle_common",
        // catalog
        "liboem_harry_vehicle_messages_catalog_v1",
        // generated code
        "libsdv_mw_rs_com_sdv_google_display_safety_har_sdv_vehicle_data_publisher",
    ],
    // Allows the library to be available inside APEX.
    apex_available: [
        "//apex_available:platform",
        "//apex_available:anyapex",
    ],
    proc_macros: [
        "libasync_trait",
    ],
    // Service bundle package is packed into /product apexes.
    product_specific: true,
}
