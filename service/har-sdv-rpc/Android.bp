rust_binary {
    name: "har_sdv_rpc",
    crate_name: "har_sdv_rpc",
    srcs: [
        "src/main.rs",
    ],

    prefer_rlib: true,
    rustlibs: [
        "google.sdv.rpc-aidl-V1-rust",
        "google.sdv.sd_common-aidl-V1-rust",
        "google.sdv.sd-aidl-V1-rust",
        "libbinder_rs",
        "liblog_rust",
        "libanyhow",
    ],
    vendor: true,
}

rust_library {
    name: "libhar_sdv_rpc",
    crate_name: "har_sdv_rpc",
    srcs: [
        "src/lib.rs",
    ],

    prefer_rlib: true,
    rustlibs: [
        "google.sdv.rpc-aidl-V1-rust",
        "google.sdv.sd_common-aidl-V1-rust",
        "google.sdv.sd-aidl-V1-rust",
        "libbinder_rs",
        "liblog_rust",
        "libanyhow",
    ],
    vendor: true,
}
