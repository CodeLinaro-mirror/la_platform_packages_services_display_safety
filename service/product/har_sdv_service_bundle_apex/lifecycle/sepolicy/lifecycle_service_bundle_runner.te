# TODO(370995822): Implement fine-grained policies for service bundles.
# Allow services to create and bind to sockets. Used in HAR.
allow untrusted_service_bundle node:tcp_socket node_bind;
allow untrusted_service_bundle port:tcp_socket name_bind;
allow untrusted_service_bundle proc_net:file { getattr open read };
allow untrusted_service_bundle self:tcp_socket { accept bind getattr getopt listen read setopt write };
allow untrusted_service_bundle port:tcp_socket name_connect;
allow untrusted_service_bundle self:tcp_socket { connect create };
