// Copyright 2024 Google LLC

package {
    default_team: "trendy_team_aaos_display_safety_triage",
}

rust_library {
    name: "libhar_sdv_orch_tests_common",
    enabled: select(soong_config_variable("SDV", "SDV_PREBUILT"), {
        "true": false,
        default: true,
    }),
    srcs: [
        "common/lib.rs",
    ],
    crate_name: "har_sdv_orch_tests_common",
    rustlibs: [
        "liblog_rust",
        // SDV Orchestrator uses ServiceFqin to communicate with Lifecycle manager API
        "google.sdv.identity-aidl-V1-rust",
        "google.sdv.lifecycle-V1-rust",
        "libbinder_rs",
        "librustutils",
    ],
}

rust_test {
    name: "har_sdv_service_bundles_integration_tests",
    enabled: select(soong_config_variable("SDV", "SDV_PREBUILT"), {
        // Don't execute these tests when we build with the binary PDK
        // Therefore, we have the inversion below, we run with the binary PDK (variable is true) => false
        "true": false,
        default: true,
    }),
    srcs: [
        "har_sdv_service_bundles_integration_tests.rs",
    ],
    rustlibs: [
        "liblog_rust",
        "google.sdv.lifecycle-V1-rust",
        // Orchestrator uses ServiceFqin to communicate with Lifecycle manager API
        "google.sdv.identity-aidl-V1-rust",
        "libsdv_vpm_api",
        "libnamed_lock",
        "libbinder_rs",
        "librustutils",
        "libhar_sdv_orch_tests_common",
        "libtokio",
        "libsdv_orch",
    ],
    test_suites: [
        "automotive-sdv-tests",
    ],
    test_options: {
        unit_test: false,
    },
    auto_gen_config: true,
    compile_multilib: "first",
    system_ext_specific: true,
    prefer_rlib: true,
    // Requires root so the test can perform Binder calls to the lifecycle manager
    require_root: true,
    // TODO(b/400972603): Implement ACLs for this test.
    test_config_template: ":sdv_authz_enforcement_flag_disabled_config_template",
}

rust_test {
    name: "har_sdv_service_monitoring_test",
    srcs: [
        "har_sdv_service_monitoring_test.rs",
    ],
    rustlibs: [
        "liblog_rust",
        "librustutils",
        "libtokio",
        "libsdv_status_rs",
        "libsdv_rs",
        "libtokio_util",
        "libprotobuf",
        "liboem_harry_vehicle_messages_catalog_v1",
        // v1 comms based on SDV generated code
        "libsdv_mw_rs_com_sdv_google_display_safety_har_sdv_service_bundle",
        "libcom_sdv_google_display_safety_driver_ui_service_rpc_rs",
    ],
    test_suites: [
        "automotive-sdv-tests",
    ],
    test_options: {
        unit_test: false,
    },
    proc_macros: [
        "libasync_trait",
    ],
    auto_gen_config: true,
    prefer_rlib: true,
    ld_flags: ["-Wl,--no-as-needed"],
    // Requires root so the test can perform Binder calls to the lifecycle manager
    require_root: true,
    // TODO(b/400972603): Implement ACLs for this test.
    test_config_template: ":sdv_authz_enforcement_flag_disabled_config_template",
}
