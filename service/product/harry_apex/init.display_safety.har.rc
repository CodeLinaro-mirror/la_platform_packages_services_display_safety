service harry /apex/com.google.display_safety.har/bin/harry
    class main
    user root
    group audio camera graphics
    oneshot
    disabled

service har_sdv_service /apex/com.google.display_safety.har/bin/har_sdv_service
    class main
    user root
    group root
    oneshot
    disabled

service fake_vehicledata_publisher_service /apex/com.google.display_safety.har/bin/fake_vehicledata_publisher_service
    class main
    user root
    group root
    oneshot
    disabled

service vehicledata_publisher_service /apex/com.google.display_safety.har/bin/vehicledata_publisher_service
    class main
    user root
    group root
    oneshot
    disabled

service har_user_preferences_service /apex/com.google.display_safety.har/bin/har_user_preferences_service
    class main
    user root
    group root
    oneshot
    disabled

service har_preferences_service /apex/com.google.display_safety.har/bin/har_preferences_service
    class main
    user root
    group root
    oneshot
    disabled

# Executing HAR and the data publisher at the earliest possible time.
on property:apex.all.ready=true
    # Start fake camera
    exec_background u:r:su:s0 -- /apex/com.google.display_safety.har/bin/ffmpeg -nostdin -stream_loop -1 -re -i /apex/com.google.display_safety.har/etc/harry/camera/camera_emulation.mp4 -f v4l2 -vcodec rawvideo -pix_fmt bgra -vf scale=640:360 /dev/video10
    # Initialize data folder. This is no-op after the first run.
    exec u:r:su:s0 -- /system/bin/sh /apex/com.google.display_safety.har/etc/com.google.display_safety.har.init_data_folder_apex.sh
    # Start the SDV User preferences service
    start har_user_preferences_service
    # Start the HAR preferences service
    start har_preferences_service
    # Start the SDV Vehicle data service
    start vehicledata_publisher_service
    # Start the mock data sender service
    start fake_vehicledata_publisher_service
    # start the HAR application
    start harry

# The proxy service needs HAR running to avoid an initial connection failure and a reconnect attempt.
on property:vendor.harplatform.grpc.started=true
    start har_sdv_service
