// Copyright 2024 Google LLC

apex {
    name: "com.google.display_safety.har",
    manifest: "apex_manifest.json",
    // Using the cert from the SDV samples.
    key: "com.google.display_safety.har.key",
    certificate: ":com.google.display_safety.har.certificate",

    binaries: [
        "harry",
        "fake_vehicledata_publisher_service",
        "vehicledata_publisher_service",
        "har_user_preferences_service",
        "har_preferences_service",
        "har_sdv_service",
        "har_preferences_admin",
    ],
    compile_multilib: "both",
    updatable: false,
    platform_apis: false,
    vendor: true,
    // The SELinux security contexts (or labels) assigned the executable and other files within the
    // APEX. It allows the definition of SELinux policies for these files.
    file_contexts: "file_contexts",
    // The init .rc script for the APEX package. It is automatically parsed by the init process
    // after the APEX package had been mounted.
    prebuilts: [
        "com.google.display_safety.har.init.rc",
        "harry_res_config",
        "harry_res_documents",
        "harry_res_fonts",
        "harry_res_audio_config",
        "harry_res_chimes_config",
        "harry_res_audio_chimes",
        "harry_res_camera_config",
        "harry_res_emulated_camera_config",
        "harry_res_camera_emulation_source",
        "com.google.display_safety.har.init_data_folder_apex.sh",
    ],
}

// openssl genrsa -out keys/com.google.display_safety.har.pem 4096
// $ANDROID_TOP_DIR/out/host/linux-x86/bin/avbtool extract_public_key \
//    --key com.google.display_safety.har.pem \
//    --output com.google.display_safety.har.avbpubkey
apex_key {
    name: "com.google.display_safety.har.key",
    public_key: "keys/com.google.display_safety.har.avbpubkey",
    private_key: "keys/com.google.display_safety.har.pem",
}

// $ANDROID_TOP_DIR/development/tools/make_key \
//     com.google.display_safety.har \
//     "/C=US/ST=California/L=Mountain View/O=Google Inc./OU=Android/CN=com.google.display_safety.har" \
//     rsa
android_app_certificate {
    name: "com.google.display_safety.har.certificate",
    certificate: "keys/com.google.display_safety.har",
}

prebuilt_etc {
    name: "com.google.display_safety.har.init.rc",
    src: "init.display_safety.har.rc",
    installable: false,
}

prebuilt_etc {
    name: "com.google.display_safety.har.init_data_folder_apex.sh",
    src: "init_data_folder.sh",
    installable: false,
}
